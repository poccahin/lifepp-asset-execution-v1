{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahin.io/schemas/lifepp.asset-execution.v1/a4-schema-manifest.schema.json",
  "title": "AssetExecutionSchemaManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "protocol_epoch",
    "claim_label",
    "hash_algorithm",
    "schema_count",
    "schemas",
    "schema_manifest_root"
  ],
  "properties": {
    "artifact_type": { "const": "AssetExecutionSchemaManifest" },
    "artifact_version": { "const": "1.0.0" },
    "protocol_epoch": { "const": "lifepp.asset-execution.v1" },
    "claim_label": { "const": "[M]" },
    "hash_algorithm": { "const": "SHA-256" },
    "schema_count": { "type": "integer", "minimum": 1 },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "raw_sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" },
          "raw_sha256": { "$ref": "#/$defs/root" }
        }
      }
    },
    "schema_manifest_root": { "$ref": "#/$defs/root" }
  },
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
