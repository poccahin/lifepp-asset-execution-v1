{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://poccahin.github.io/schemas/lifepp.asset-execution.v1/asset-execution-receipt.schema.json",
  "title":"AssetExecutionReceipt",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_type","artifact_version","claim_label","evidence_class","chain_id","transaction_signature","transaction_message_root","asset_execution_policy_root","permit_root","timelock_root","pocc_certificate_root","treasury_approval_root","initial_simulation_roots","pre_execution_simulation_roots","submission_slot","confirmed_slot","chain_finality_status","post_state_root","independent_executor_attestation_root","transaction_submission_observed","asset_execution_permit_verified","treasury_approval_verified","receipt_root"],
  "properties":{
    "artifact_type":{"const":"AssetExecutionReceipt"},
    "artifact_version":{"const":"1.0.0"},
    "claim_label":{"const":"[RET]"},
    "evidence_class":{"const":"LIVE_VERIFIED"},
    "chain_id":{"type":"string","minLength":1},
    "transaction_signature":{"type":"string","minLength":1},
    "transaction_message_root":{"$ref":"#/$defs/root"},
    "asset_execution_policy_root":{"$ref":"#/$defs/root"},
    "permit_root":{"$ref":"#/$defs/root"},
    "timelock_root":{"$ref":"#/$defs/root"},
    "pocc_certificate_root":{"$ref":"#/$defs/root"},
    "treasury_approval_root":{"$ref":"#/$defs/root"},
    "initial_simulation_roots":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/root"}},
    "pre_execution_simulation_roots":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/root"}},
    "submission_slot":{"type":"integer","minimum":0},
    "confirmed_slot":{"type":"integer","minimum":0},
    "chain_finality_status":{"const":"FINALIZED"},
    "post_state_root":{"$ref":"#/$defs/root"},
    "independent_executor_attestation_root":{"$ref":"#/$defs/root"},
    "transaction_submission_observed":{"const":true},
    "asset_execution_permit_verified":{"const":true},
    "treasury_approval_verified":{"const":true},
    "receipt_root":{"$ref":"#/$defs/root"}
  },
  "$defs":{"root":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
